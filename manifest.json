{
  "name": "Kharcha",
  "short_name": "Kharcha",
  "description": "Categorise credit card statement spends into budget buckets, on your device.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E0E0C",
  "theme_color": "#0E0E0C",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdfs",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}